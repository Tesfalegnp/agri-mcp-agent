# ==============================================================================
# Agricultural MCP Assistant - Environment Variables Example
# ==============================================================================
# NOTE: Do NOT store actual secrets or private API keys in this file.
# Copy this file to .env for local runtime configuration.
# .env is explicitly excluded from version control via .gitignore.

# Application Environment (development, testing, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Note: For stdio MCP servers, all application logs are output to stderr.
LOG_LEVEL=INFO

# External Weather Provider URL (defaults to Open-Meteo public forecast API)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# SQLite Database Storage Path
DATABASE_PATH=data/agricultural_assistant.db

# ==============================================================================
# Phase 7: Gemini AI Assistant Configuration (Free Tier)
# ==============================================================================
# Gemini Model selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google Gemini API Key (Never commit the actual key to version control)
# Set your actual key in local .env; leave blank or unset to run with mocked AI responses
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend API Base URL for Vite development
VITE_API_BASE_URL=http://localhost:8000

# Backend Web Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
